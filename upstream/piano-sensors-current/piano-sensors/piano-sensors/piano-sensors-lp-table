#!/usr/bin/env python3
"""Print a read-only device-mapper linear table for one logical partition
of an Android super partition (liblp metadata, primary copy, slot 0)."""
import struct, sys

GEOMETRY_MAGIC = 0x616C4467
HEADER_MAGIC = 0x414C5030
SECTOR = 512

def main(dev, name):
    with open(dev, 'rb') as f:
        f.seek(4096)
        geo = f.read(4096)
        magic, _size, _csum, meta_max, _slots, _lbs = struct.unpack_from('<II32sIII', geo)
        if magic != GEOMETRY_MAGIC:
            sys.exit('no super geometry')
        f.seek(4096 + 4096 * 2)  # primary metadata, slot 0
        hdr = f.read(meta_max)
    magic, major, minor, hsize = struct.unpack_from('<IHHI', hdr)
    if magic != HEADER_MAGIC:
        sys.exit('no super metadata header')
    tables = hdr[hsize:]
    # descriptors after magic/major/minor/header_size/csum/tables_size/csum
    off = 4 + 2 + 2 + 4 + 32 + 4 + 32
    parts, extents = [struct.unpack_from('<III', hdr, off + i * 12) for i in range(2)]
    for i in range(parts[1]):
        e = parts[0] + i * parts[2]
        pname = tables[e:e + 36].split(b'\0')[0].decode()
        _attr, first, num, _grp = struct.unpack_from('<IIII', tables, e + 36)
        if pname != name:
            continue
        start = 0
        for j in range(first, first + num):
            x = extents[0] + j * extents[2]
            nsec, ttype, tdata, _src = struct.unpack_from('<QIQI', tables, x)
            if ttype != 0:
                sys.exit('unsupported extent type %d' % ttype)
            print('%d %d linear %s %d' % (start, nsec, dev, tdata))
            start += nsec
        return
    sys.exit('partition %s not found' % name)

if __name__ == '__main__':
    main(sys.argv[1], sys.argv[2])
