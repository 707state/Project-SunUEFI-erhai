# Xiaomi Pad 8 Pro: the accelerometer and proximity sensors sit on the ADSP
# sensors hub (80-iio-sensor-proxy.rules already adds light and compass).
# The accelerometer is mounted with x and y swapped against the panel's
# natural (landscape) orientation.
SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp*", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel ssc-proximity", ENV{ACCEL_MOUNT_MATRIX}="0, 1, 0; -1, 0, 0; 0, 0, 1"
