[Unit]
Description=Sensors PD aDSP RPC daemon (Xiaomi Pad 8 Pro)
Requires=piano-sensors-import.service
After=piano-sensors-import.service piano-adsp.service
Before=iio-sensor-proxy.service

[Service]
Type=exec
# fastrpc is kept off the automatic module loading list on piano; load it
# once the ADSP runs and wait for its device node.
ExecStartPre=/usr/sbin/modprobe fastrpc
ExecStartPre=/bin/sh -c 'for i in $$(seq 60); do [ -e /dev/fastrpc-adsp-secure ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/sbin/adsprpcd sensorspd
# Started only once the PD has published its sensors: iio-sensor-proxy
# looks them up a single time.
ExecStartPost=/usr/libexec/piano-sensors/piano-sensors-wait
TimeoutStartSec=180
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
