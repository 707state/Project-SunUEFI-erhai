# Host-only erhai stage-0 diagnostic; NOT hardware validated.
# Native DXE binaries are erhai's OWN, extracted from the device's uefi_a.img
# FVMAIN (vendor/erhai/native, 2026-10-13). Dispatch order follows the vendor's
# own FVMAIN sequence; the TZ trio is restored with erhai SCM/Tz binaries that
# match this device's TrustZone. Storage: erhai UFSDxe + Mu disk generics.
# Native dispatch order mirrors dodgePkg/Include/APRIORI.inc: SmemDxe -> DALSYS
# -> HWIO -> ChipInfo. The piano (Xiaomi) order ChipInfo-first deadlocks the
# statically-linked DALModEnv inside ChipInfoDxe (DALModEnv.c+115 !EFI_ERROR).
# Storage bring-up: UFS via the dodge UFSDxe (BlockIO for LU0..7) plus the
# generic Disk/Partition/FAT stack so the ESP can be enumerated. The clock and
# rail dependencies follow dodge's own APRIORI order (ULog/IPCC/CmdDb/PwrUtils/
# Npa/Rpmh/Mailbox/Vcs/Clock/ICB); PMIC-dependent modules are still excluded.
# Bisect round 2 (2026-10-13, real erhai DTB): full stack still dies after
# Vcs/Clock with NO auto-reboot -> the DXE core hangs inside/after these dodge
# binaries regardless of DTB provenance. This round: VcsDxe kept, ClockDxe out.
# Prior bisect: both out -> display alive, UFSDxe dies at UfsCoreBspLib.c+188.
# Bisect result (2026-10-13): removing VcsDxe+ClockDxe keeps the inherited
# display alive but UFSDxe then dies at UfsCoreBspLib.c+188 (host controller
# init without clock/voltage). The display loss and the UFS requirements share
# the same clock/rail stack; the fix is a real erhai DTB with piano-style
# display-clock-lease handling, not dropping drivers.
# The dodge TZ trio (ShmBridgeDxeLA / ScmDxeCompat / TzDxeLA) is deliberately
# absent: its BOOT.MXF.2.5.1 SmcInvokeInit returns EFI_NOT_FOUND on erhai's TZ
# firmware and hangs dispatch. Stage-0 needs no SCM. Restore TZ from erhai's
# own firmware extraction before building anything that talks to QSEE.
[FD.SILICIUM_UEFI]
BaseAddress = $(FD_BASE)|gArmTokenSpaceGuid.PcdFdBaseAddress
Size = $(FD_SIZE)|gArmTokenSpaceGuid.PcdFdSize
ErasePolarity = 1
BlockSize = 0x1000
NumBlocks = $(FD_BLOCKS)
0x00000000|$(FD_SIZE)
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT
[FV.FVMAIN_COMPACT]
FvAlignment = 8
ERASE_POLARITY = 1
MEMORY_MAPPED = TRUE
READ_ENABLED_CAP = TRUE
READ_STATUS = TRUE
  INF SiliciumPkg/Sec/Sec.inf
  FILE FV_IMAGE = 9E21FD93-9C72-4C15-8C4B-E77F1DB2D792 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVMAIN
    }
  }
[FV.FVMAIN]
FvNameGuid = CD8D4C84-20AD-4073-8A28-3400FAE05941
BlockSize = 0x1000
NumBlocks = 0
FvAlignment = 8
ERASE_POLARITY = 1
MEMORY_MAPPED = TRUE
READ_ENABLED_CAP = TRUE
READ_STATUS = TRUE
  APRIORI DXE {
    INF MdeModulePkg/Core/Dxe/DxeMain.inf
    INF MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
    INF MdeModulePkg/Core/RuntimeDxe/RuntimeDxe.inf
