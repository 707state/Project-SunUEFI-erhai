  # Vendor freeform config files the native drivers look up in the FV
  # (UFSDxe: "Failed to load SecParti.cfg"; QcomBds wants BDS_Menu.cfg).
  FILE FREEFORM = A1E235DE-E825-4591-9623-C43175811826 {
    SECTION RAW = Binaries/erhai/cfg/SecParti.cfg
    SECTION UI = "SecParti.cfg"
  }
  FILE FREEFORM = A91D838E-A5FA-4138-825D-455E2303079E {
    SECTION RAW = Binaries/erhai/cfg/BDS_Menu.cfg
    SECTION UI = "BDS_Menu.cfg"
  }
  # Vendor SLT/panel database FV (decompressed from the uefi_a outer-FV file
  # D14C51ED-...): CalibrationDxe looks this FV up by its file GUID and reads
  # SLT platform data; DisplayDxe-era panels (incl. Panel_XN242 XML) live here.
  FILE FV_IMAGE = D14C51ED-4F4D-2F2D-EAE4-77914692D046 {
    SECTION RAW = Binaries/erhai/slt/panel-fv.bin
    SECTION UI = "SLT"
  }

  # uefiplat.cfg: the OUTER-FV text config (GUID DDE58710, 501 B) that
  # CalibrationDxe looks up by name; the FVMAIN FC510EE7 binary blob is a
  # different (encrypted SLT?) artifact and is NOT what the name search wants.
  FILE FREEFORM = DDE58710-41CD-4306-DBFB-3FA90BB1D2DD {
    SECTION RAW = Binaries/erhai/cfg/uefiplat.cfg
    SECTION UI = "uefiplat.cfg"
  }

