  PianoUfsProbe.c
  PianoDma.c
  PianoSmmu.c
  PianoIoPageTable.c
  PianoOwnedSmmu.c
  PianoFaultRecovery.c
  PianoUfsDmaLayout.c
  PianoReadOnlyBlock.c
  PianoGpt.c
  PianoUfsReadOnlyDma.c

[BuildOptions]
  *_*_AARCH64_CC_FLAGS = -DPIANO_UFS_BLOCKIO

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  QcomPkg/QcomPkg.dec
  SiliciumPkg/SiliciumPkg.dec
  erhaiPkg/erhai.dec

[LibraryClasses]
  UefiLib
  ArmSmcLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiDriverEntryPoint
  DxeServicesLib
  DxeServicesTableLib
  FdtLib
  IoLib
  DebugLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  MemoryMapHelperLib
  CacheMaintenanceLib
  TimerLib
  PrintLib

[Protocols]
  gEfiClockProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiDevicePathProtocolGuid
  gEfiCpuArchProtocolGuid

[Guids]
  gEfiEventExitBootServicesGuid

[Depex]
