[Defines]
  INF_VERSION = 0x0001001B
  BASE_NAME = ErhaiUfsDxe
  FILE_GUID = 7C2F9B84-D3A1-4E57-B2C8-91F6A0D4E2B7
  MODULE_TYPE = UEFI_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT = ErhaiUfsDxeEntry

[Sources]
