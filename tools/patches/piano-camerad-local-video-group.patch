Subject: [PATCH] camera: resolve the local video group without loading NSS modules

The static camera helper needs the local device-access group, not network
accounts. Arch's group NSS chain merges systemd records even for a successful
files lookup; dlopening that host NSS library into a static Debian libc can
crash before camera setup. Read the local group database explicitly while
preserving its real numeric gid and socket permissions.

--- a/camera/piano-camerad.c
+++ b/camera/piano-camerad.c
@@ -1723,15 +1723,34 @@
 	control_error(out, "control", EINVAL, false);
 }
 
+static int local_video_gid(gid_t *gid)
+{
+	FILE *file = fopen("/etc/group", "re");
+	struct group *group;
+	int found = 0;
+
+	if (!file)
+		return -1;
+	while ((group = fgetgrent(file))) {
+		if (!strcmp(group->gr_name, "video")) {
+			*gid = group->gr_gid;
+			found = 1;
+			break;
+		}
+	}
+	fclose(file);
+	return found ? 0 : -1;
+}
+
 static int control_open(void)
 {
 	struct sockaddr_un sa = { .sun_family = AF_UNIX, .sun_path = CONTROL_PATH };
-	struct group *video = getgrnam("video");
+	gid_t video_gid;
 	struct stat st;
 	mode_t old;
 	int fd, error;
 
-	if (!video || geteuid() != 0) {
+	if (geteuid() != 0 || local_video_gid(&video_gid)) {
 		errno = EPERM;
 		return -1;
 	}
@@ -1741,7 +1760,7 @@
 		errno = EPERM;
 		return -1;
 	}
-	if (chown("/run/piano-camerad", 0, video->gr_gid) < 0 || chmod("/run/piano-camerad", 0750) < 0)
+	if (chown("/run/piano-camerad", 0, video_gid) < 0 || chmod("/run/piano-camerad", 0750) < 0)
 		return -1;
 	if (!lstat(CONTROL_PATH, &st)) {
 		if (!S_ISSOCK(st.st_mode) || st.st_uid != 0) {
@@ -1761,7 +1780,7 @@
 	umask(old);
 	if (bound < 0)
 		goto fail;
-	if (chown(CONTROL_PATH, 0, video->gr_gid) < 0 || chmod(CONTROL_PATH, 0660) < 0 ||
+	if (chown(CONTROL_PATH, 0, video_gid) < 0 || chmod(CONTROL_PATH, 0660) < 0 ||
 	    listen(fd, CONTROL_CLIENTS) < 0) {
 		error = errno;
 		unlink(CONTROL_PATH);
