# Piano ARM64 variant of Arch Linux ARM's Mesa 26.2.4 package recipe.
# Keep the regular Mesa/libglvnd paths and package names for desktop consumers.
pkgbase=piano-mesa
pkgname=(mesa vulkan-freedreno)
pkgver=26.2.4
pkgrel=1.1
epoch=1
pkgdesc='Mesa graphics for Piano, including Adreno 830v1'
arch=(aarch64)
url='https://www.mesa3d.org/'
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
makedepends=(base-devel meson python-mako python-packaging python-ply python-yaml
             glslang spirv-tools llvm clang libclc expat libdrm libelf libglvnd
             libx11 libxcb libxext libxrandr libxshmfence libxxf86vm wayland
             wayland-protocols xorgproto libdisplay-info xcb-util-keysyms
             vulkan-icd-loader zstd)
options=(!lto !debug)
source=("https://archive.mesa3d.org/mesa-$pkgver.tar.xz"
        '0001-freedreno-Add-chip-id-support-for-A830v1.patch')
b2sums=('28506a9366e3c031acbb52924e43b0ec098f44a3ac3bb839ec2a86fa0faf83652347704b0e58bdc447aaebae5a2a254e5456e0b893755fd7721e57d6b614ecc4'
        'e675b526263b6e961870aec23b2f9ba0e69bdc4a52dd7503aae61a762427de7103198567c2a8c35386357855bee6f1c61dfda0500692960363363abb0decb193')

prepare() {
  cd "mesa-$pkgver"
  patch --forward --fuzz=0 -Np1 < ../0001-freedreno-Add-chip-id-support-for-A830v1.patch
  echo "$pkgver-sunuefi$pkgrel" > VERSION
}

build() {
  arch-meson "mesa-$pkgver" build \
    -Dgallium-drivers=freedreno,llvmpipe,softpipe,zink \
    -Dvulkan-drivers=freedreno \
    -Dfreedreno-kmds=msm,virtio \
    -Dplatforms=x11,wayland \
    -Dglvnd=enabled -Dgles1=disabled -Dgles2=enabled \
    -Dllvm=enabled -Dshared-llvm=enabled \
    -Dgallium-va=disabled -Dgallium-rusticl=false -Dgallium-mediafoundation=disabled \
    -Dbuild-tests=false -Dhtml-docs=disabled \
    -Dandroid-libbacktrace=disabled -Dmicrosoft-clc=disabled \
    -Dintel-rt=disabled -Dlibunwind=disabled -Dvalgrind=disabled \
    -Dvulkan-layers= -Dvulkan-manifest-per-architecture=false
  meson compile -C build -j6
}

package_mesa() {
  depends=(expat glibc libdrm libelf libgcc libglvnd libstdc++ libx11 libxcb
           libxext libxshmfence libxxf86vm llvm-libs spirv-tools wayland zlib zstd)
  provides=("mesa-libgl=$epoch:$pkgver-$pkgrel" opengl-driver)
  conflicts=('mesa-libgl<17.0.1-2')
  meson install -C build --destdir "$pkgdir" --no-rebuild
  mkdir -p "$srcdir/turnip/usr/lib" "$srcdir/turnip/usr/share/vulkan/icd.d"
  mv "$pkgdir/usr/lib/libvulkan_freedreno.so" "$srcdir/turnip/usr/lib/"
  mv "$pkgdir/usr/share/vulkan/icd.d/freedreno_icd.json" "$srcdir/turnip/usr/share/vulkan/icd.d/"
  install -Dm644 "mesa-$pkgver/docs/license.rst" "$pkgdir/usr/share/licenses/mesa/LICENSE"
}

package_vulkan-freedreno() {
  pkgdesc='Turnip Vulkan driver for Adreno 830v1'
  depends=(expat glibc libdisplay-info libdrm libgcc libstdc++ libx11 libxcb
           libxshmfence spirv-tools systemd-libs vulkan-icd-loader
           wayland xcb-util-keysyms zlib zstd)
  provides=(vulkan-driver)
  cp -a "$srcdir/turnip/." "$pkgdir/"
  install -Dm644 "mesa-$pkgver/docs/license.rst" "$pkgdir/usr/share/licenses/vulkan-freedreno/LICENSE"
}
