# erhai first-boot kernel profile: merge over piano_defconfig.
# Scope: EFI stub boot from UEFI BDS, UFS root, UART7 console, USB DWC3.
# Everything display/audio/wireless is deferred until basic boot works.
#
# The kernel is started by BDS platform recovery from \EFI\BOOT\BOOTAA64.EFI
# on the ESP. The EFI stub loads dtb= and initrd= from the same FAT volume,
# relative to the volume root (not the kernel directory), and ignores them
# only when UEFI Secure Boot is enabled. This firmware has no SecureBoot
# variable, so EFI_ARMSTUB_DTB_LOADER is the intended handoff path.
# Root selection uses the filesystem label: the erhai GPT entries were carved
# without unique partition GUIDs, so PARTUUID= is not usable yet.
CONFIG_CMDLINE="dtb=EFI/BOOT/erhai.dtb initrd=EFI/BOOT/initramfs.cpio.gz console=ttyMSM0,115200n8 loglevel=8 ignore_loglevel root=LABEL=sunuefi_root rootfstype=ext4 rootwait rw pd_ignore_unused clk_ignore_unused iommu.passthrough=1 panic=15"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
# CONFIG_CMDLINE_FORCE is not set

# EFI stub — required for the UEFI handoff
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARAMS_FROM_FDT=y
CONFIG_EFI_RUNTIME_WRAPPERS=y
CONFIG_EFI_ARMSTUB_DTB_LOADER=y

# initramfs + gzip for the ESP initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# UFS + SCSI. The PHY and SM8750 pin controller must be built in: the root
# filesystem is mounted before any module can be loaded from it.
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PINCTRL_SM8750=y

# ext4 root
CONFIG_EXT4_FS=y

# UART console (GENI debug uart = uart7; the driver registers ttyMSM)
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# USB device/host
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y

# On-screen bring-up logs: the EFI stub hands the GOP framebuffer to sysfb,
# and simpledrm/fbcon take it over until the real display driver exists.
CONFIG_SYSFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# UEFI hands off at EL1 without PAC keys / BTI trampolines / MTE tagging set up.
# The EFI stub's first instruction (PACIASP) faults if the kernel is built with
# pointer authentication. Keep these off until the firmware programs them.
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_MTE is not set
