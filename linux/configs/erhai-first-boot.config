# erhai first-boot kernel profile: merge over piano_defconfig.
# Scope: EFI stub boot from UEFI, UFS root, UART7 console, USB DWC3.
# Everything display/audio/wireless is deferred until basic boot works.
CONFIG_CMDLINE="console=ttyMS0,115200n8 loglevel=7 root=/dev/sda17 rootfstype=ext4 rootwait rw pd_ignore_unused clk_ignore_unused panic=-1 init=/bin/sh"

# EFI stub — required for the UEFI handoff
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARAMS_FROM_FDT=y
CONFIG_EFI_RUNTIME_WRAPPERS=y

# initramfs + gzip for the ESP initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# UFS + SCSI
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_BLK_DEV_SD=y

# ext4 root
CONFIG_EXT4_FS=y

# UART console (GENI debug uart = uart7)
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# USB device/host
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
