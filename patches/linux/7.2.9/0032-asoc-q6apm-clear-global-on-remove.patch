From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] ASoC: q6apm: serialize readiness queries with device removal

An ADSP crash removes the APM device and frees its managed data. The global
g_apm pointer survives removal, so PRM probing during DSP recovery can send
a readiness command through freed storage. Piano's crash trace reaches
audioreach_send_cmd_sync from q6apm_is_adsp_ready and faults on its mutex.

Protect the global pointer and the whole synchronous readiness query with
a separate mutex. Clear the pointer before removal and on population
failure. Publish only after successful component registration. Return false
on allocation or command errors rather than interpreting negative errno as
a ready DSP.

This addresses the recovery-time use-after-free. It does not fix the
FastRPC listener assertion that initially crashes the DSP.
---
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 6f19775163a..240d4a469ba 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -28,6 +28,15 @@ struct apm_graph_mgmt_cmd {
 #define APM_GRAPH_MGMT_PSIZE(p, n) ALIGN(struct_size(p, sub_graph_id_list, n), 8)
 
 static struct q6apm *g_apm;
+static DEFINE_MUTEX(g_apm_lock);
+
+static void q6apm_clear_global(struct q6apm *apm)
+{
+	mutex_lock(&g_apm_lock);
+	if (g_apm == apm)
+		g_apm = NULL;
+	mutex_unlock(&g_apm_lock);
+}
 
 int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
 			uint32_t rsp_opcode)
@@ -142,22 +151,31 @@ static void q6apm_put_audioreach_graph(struct kref *ref)
 
 static int q6apm_get_apm_state(struct q6apm *apm)
 {
+	int ret;
 	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(0,
 								APM_CMD_GET_SPF_STATE, 0);
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
 
-	q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_GET_SPF_STATE);
+	ret = q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_GET_SPF_STATE);
+	if (ret < 0)
+		return ret;
 
 	return apm->state;
 }
 
 bool q6apm_is_adsp_ready(void)
 {
+	bool ready = false;
+
+	/* A DSP restart removes the APM device. Keep it alive for the whole
+	 * query, including the synchronous command's wait for a reply. */
+	mutex_lock(&g_apm_lock);
 	if (g_apm)
-		return q6apm_get_apm_state(g_apm);
+		ready = q6apm_get_apm_state(g_apm) > 0;
+	mutex_unlock(&g_apm_lock);
 
-	return false;
+	return ready;
 }
 EXPORT_SYMBOL_GPL(q6apm_is_adsp_ready);
 
@@ -881,7 +899,6 @@ static int apm_probe(gpr_device_t *gdev)
 
 	idr_init(&apm->modules_idr);
 
-	g_apm = apm;
 	audioreach_set_apm_src_port(gdev->svc_id);
 
 	q6apm_get_apm_state(apm);
@@ -892,15 +909,22 @@ static int apm_probe(gpr_device_t *gdev)
 		return ret;
 	}
 
+	mutex_lock(&g_apm_lock);
+	g_apm = apm;
+	mutex_unlock(&g_apm_lock);
+
 	ret = of_platform_populate(dev->of_node, NULL, NULL, dev);
-	if (ret)
+	if (ret) {
+		q6apm_clear_global(apm);
 		snd_soc_unregister_component(dev);
+	}
 
 	return ret;
 }
 
 static void apm_remove(gpr_device_t *gdev)
 {
+	q6apm_clear_global(dev_get_drvdata(&gdev->dev));
 	of_platform_depopulate(&gdev->dev);
 	snd_soc_unregister_component(&gdev->dev);
 }
