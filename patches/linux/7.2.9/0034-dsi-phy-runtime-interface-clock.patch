From b95037aef0a0bf5cd612e7517a67644887e9fd5d Mon Sep 17 00:00:00 2001
From: Junhao Xie <bigfoot@radxa.com>
Subject: [PATCH] drm/msm/dsi/phy: manage the interface clock from runtime PM directly

Source: https://github.com/BigfootACA/linux/commit/b95037aef0a0bf5cd612e7517a67644887e9fd5d

pm_clk keeps the interface clock prepared for the device lifetime, holding
the clock provider's runtime PM reference even when the PHY is suspended.
Pair prepare/unprepare with enable/disable in the runtime callbacks.

Adapted header context for SunUEFI's existing PHY recovery helpers.
Included in the default release after Piano boot, display power-cycle,
system suspend/resume and reboot checks.

Signed-off-by: Junhao Xie <bigfoot@radxa.com>
---
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
@@ -5,7 +5,6 @@
 
 #include <linux/clk-provider.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <dt-bindings/phy/phy.h>
 
@@ -685,13 +684,10 @@
 	if (ret)
 		return ret;
 
-	ret = devm_pm_clk_create(dev);
-	if (ret)
-		return ret;
-
-	ret = pm_clk_add(dev, "iface");
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "Unable to get iface clk\n");
+	phy->ahb_clk = devm_clk_get(dev, "iface");
+	if (IS_ERR(phy->ahb_clk))
+		return dev_err_probe(dev, PTR_ERR(phy->ahb_clk),
+				     "Unable to get iface clk\n");
 
 	if (phy->cfg->ops.pll_init) {
 		ret = phy->cfg->ops.pll_init(phy);
@@ -709,8 +705,24 @@
 	return 0;
 }
 
+static int dsi_phy_runtime_suspend(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(phy->ahb_clk);
+
+	return 0;
+}
+
+static int dsi_phy_runtime_resume(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(phy->ahb_clk);
+}
+
 static const struct dev_pm_ops dsi_phy_pm_ops = {
-	SET_RUNTIME_PM_OPS(pm_clk_suspend, pm_clk_resume, NULL)
+	RUNTIME_PM_OPS(dsi_phy_runtime_suspend, dsi_phy_runtime_resume, NULL)
 };
 
 static struct platform_driver dsi_phy_platform_driver = {
@@ -718,7 +730,7 @@
 	.driver     = {
 		.name   = "msm_dsi_phy",
 		.of_match_table = dsi_phy_dt_match,
-		.pm = &dsi_phy_pm_ops,
+		.pm = pm_ptr(&dsi_phy_pm_ops),
 	},
 };
 
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
@@ -125,6 +125,8 @@
 	struct clk_hw_onecell_data *provided_clocks;
 
 	bool state_saved;
+
+	struct clk *ahb_clk;
 };
 
 void msm_dsi_phy_toggle_resync_fifo(struct msm_dsi_phy *phy);
