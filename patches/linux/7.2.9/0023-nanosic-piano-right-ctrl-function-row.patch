Subject: [PATCH] HID: nanosic: use Right Ctrl as the Piano function row

Map the cover keyboard number row to F1-F12 while Right Ctrl is held.
Keep the translated usage latched until physical release. Left Ctrl and
other modifiers remain available for modified function-key shortcuts.
The Sheng keyboard retains its existing behavior.

--- a/drivers/hid/hid-nanosic-wn8030.c
+++ b/drivers/hid/hid-nanosic-wn8030.c
@@ -96,6 +96,7 @@
 	bool tablet_mode;
 	bool capslock_enabled;
 	bool micmute_key_down;
+	u16 fn_held;
 	struct led_classdev micmute_led;
 	struct led_classdev kbd_backlight_led;
 
@@ -761,6 +762,40 @@
 	return false;
 }
 
+/* Right Ctrl is the cover's missing Fn layer: 1..0,-,= -> F1..F12.
+ * Latch translated keys until physical release, even if Ctrl is released
+ * first. Never emit a stray digit or leave a function key stuck down.
+ */
+static void nanosic_wn8030_function_row(struct nanosic_wn8030 *nanosic,
+				      const u8 *report, u8 *mapped)
+{
+	u16 present = 0;
+	bool control = report[1] & BIT(4);
+	int i;
+
+	memcpy(mapped, report, 9);
+	if (!nanosic->variant->packed_reports)
+		return;
+	for (i = 3; i < 9; i++)
+		if (report[i] >= 1 && report[i] <= 3)
+			return; /* Let HID preserve its rollover state. */
+	for (i = 3; i < 9; i++) {
+		u8 key = report[i];
+		int slot = key >= 0x1e && key <= 0x27 ? key - 0x1e :
+			   key == 0x2d ? 10 : key == 0x2e ? 11 : -1;
+		if (slot < 0)
+			continue;
+		present |= BIT(slot);
+		if (control || (nanosic->fn_held & BIT(slot))) {
+			nanosic->fn_held |= BIT(slot);
+			mapped[i] = 0x3a + slot;
+		}
+	}
+	nanosic->fn_held &= present;
+	if (nanosic->fn_held)
+		mapped[1] &= ~BIT(4);
+}
+
 static int nanosic_wn8030_set_touchpad(struct nanosic_wn8030 *nanosic, bool enable)
 {
 	u8 buf[XM_WN8030_I2C_WRITE] = { 0x32, 0x00, 0x4E, 0x31,
@@ -1119,6 +1154,7 @@
 	case 0x5: {
 		bool micmute_down;
 		bool micmute_was_down;
+		u8 mapped[9];
 
 		if (!READ_ONCE(nanosic->input_enabled))
 			break;
@@ -1126,9 +1162,13 @@
 		micmute_was_down = READ_ONCE(nanosic->micmute_key_down);
 		if (micmute_down && !micmute_was_down)
 			WRITE_ONCE(nanosic->micmute_key_down, true);
-		if (nanosic->hid_keyboard)
+		if (nanosic->hid_keyboard) {
+			mutex_lock(&nanosic->conn_mutex);
+			nanosic_wn8030_function_row(nanosic, p, mapped);
 			hid_input_report(nanosic->hid_keyboard, HID_INPUT_REPORT,
-					 (u8 *)p, size, 0);
+					 mapped, sizeof(mapped), 0);
+			mutex_unlock(&nanosic->conn_mutex);
+		}
 		if (!micmute_down && micmute_was_down) {
 			bool enable;
 
@@ -1471,6 +1511,7 @@
 		hid_input_report(nanosic->hid_touchpad, HID_INPUT_REPORT,
 				 touchpad, sizeof(touchpad), 0);
 	WRITE_ONCE(nanosic->micmute_key_down, false);
+	nanosic->fn_held = 0;
 }
 
 static void nanosic_wn8030_input_state_work(struct work_struct *work)
