From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] soc: qcom: notify the DSPs before system sleep

The firmware publishes a qcom,smp2p-sleepstate entry and a matching
"qcom,smp2p-sleepstate" device node, but mainline has no driver for it.
The node therefore stayed unbound and the ADSP was never told that the
application processor was entering system sleep.

On Piano an ADSP fatal error was observed after suspend, followed by an
Oops during APR/GPR device registration and a subsequent freezer timeout.
The missing notification is a candidate cause; the firmware error itself
reports a FastRPC listener assertion. This patch still needs device
validation and does not fix the separate q6apm lifetime issue.

Add the missing notifier. It owns the "sleepstate" SMP2P entry, clears
the AP-awake bit on PM_SUSPEND_PREPARE and sets it again on
PM_POST_SUSPEND, and keeps the inbound sleepstate IRQ as a wakeup source
so a DSP-initiated wake still reaches the PM core. The driver is a
standard platform driver enabled by CONFIG_QCOM_SMP2P_SLEEPSTATE.

Initialize the wakeup source before requesting its IRQ. Managed cleanup
unregisters the notifier, synchronizes the IRQ, and releases the source.
Protocol source: MiCode/Xiaomi_Kernel_OpenSource at
45fb9bd6ae5ba2942fc1d53e4b6b46ef76992f71,
drivers/soc/qcom/smp2p_sleepstate.c.

Signed-off-by: slwyts <slwyts@foxmail.com>
---
diff --git a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
index 2caadbbcf83..45cd2b18596 100644
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -209,6 +209,18 @@ config QCOM_SMP2P
 	  Say yes here to support the Qualcomm Shared Memory Point to Point
 	  protocol.
 
+config QCOM_SMP2P_SLEEPSTATE
+	tristate "Qualcomm SMP2P sleep-state notifier"
+	depends on QCOM_SMP2P
+	help
+	  Say yes here to notify the remote processors over SMP2P that the
+	  application processor is entering or leaving system sleep. Firmware
+	  that publishes a qcom,smp2p-sleepstate entry needs this, otherwise
+	  the DSP watchdog fires right after system resume.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called smp2p_sleepstate.
+
 config QCOM_SMSM
 	tristate "Qualcomm Shared Memory State Machine"
 	depends on MAILBOX
diff --git a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
index b7f1d2a5736..250b9c88f3e 100644
--- a/drivers/soc/qcom/Makefile
+++ b/drivers/soc/qcom/Makefile
@@ -27,6 +27,7 @@ obj-$(CONFIG_QCOM_SMEM) +=	smem.o
 obj-$(CONFIG_QCOM_SMEM_STATE) += smem_state.o
 CFLAGS_smp2p.o := -I$(src)
 obj-$(CONFIG_QCOM_SMP2P)	+= smp2p.o
+obj-$(CONFIG_QCOM_SMP2P_SLEEPSTATE) += smp2p_sleepstate.o
 obj-$(CONFIG_QCOM_SMSM)	+= smsm.o
 obj-$(CONFIG_QCOM_SOCINFO)	+= socinfo.o
 obj-$(CONFIG_QCOM_SPM)		+= spm.o
diff --git a/drivers/soc/qcom/smp2p_sleepstate.c b/drivers/soc/qcom/smp2p_sleepstate.c
new file mode 100644
index 00000000000..70f1a4e6e86
--- /dev/null
+++ b/drivers/soc/qcom/smp2p_sleepstate.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm SMP2P sleep-state notifier
+ *
+ * The remote processors (ADSP/CDSP) need to know when the application
+ * processor is about to enter system sleep. The vendor firmware published
+ * a "sleepstate" SMP2P entry for this; without the notification the DSP
+ * needs the AP-awake indication during suspend and resume.
+ */
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/pm_wakeup.h>
+#include <linux/soc/qcom/smem_state.h>
+#include <linux/suspend.h>
+
+#define PROC_AWAKE_ID	12
+#define AWAKE_BIT	BIT(PROC_AWAKE_ID)
+
+struct smp2p_sleepstate {
+	struct qcom_smem_state *state;
+	struct wakeup_source *ws;
+	struct notifier_block pm_nb;
+};
+
+static int smp2p_sleepstate_pm_notifier(struct notifier_block *nb,
+					unsigned long event, void *unused)
+{
+	struct smp2p_sleepstate *ss = container_of(nb, struct smp2p_sleepstate, pm_nb);
+
+	switch (event) {
+	case PM_SUSPEND_PREPARE:
+		qcom_smem_state_update_bits(ss->state, AWAKE_BIT, 0);
+		break;
+	case PM_POST_SUSPEND:
+		qcom_smem_state_update_bits(ss->state, AWAKE_BIT, AWAKE_BIT);
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static irqreturn_t smp2p_sleepstate_handler(int irq, void *data)
+{
+	struct smp2p_sleepstate *ss = data;
+
+	__pm_wakeup_event(ss->ws, 200);
+
+	return IRQ_HANDLED;
+}
+
+static void smp2p_sleepstate_release_ws(void *data)
+{
+	struct smp2p_sleepstate *ss = data;
+
+	wakeup_source_unregister(ss->ws);
+}
+
+static void smp2p_sleepstate_release_notifier(void *data)
+{
+	struct smp2p_sleepstate *ss = data;
+
+	unregister_pm_notifier(&ss->pm_nb);
+}
+
+static int smp2p_sleepstate_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct smp2p_sleepstate *ss;
+	unsigned int bit;
+	int irq, ret;
+
+	ss = devm_kzalloc(dev, sizeof(*ss), GFP_KERNEL);
+	if (!ss)
+		return -ENOMEM;
+
+	ss->state = devm_qcom_smem_state_get(dev, NULL, &bit);
+	if (IS_ERR(ss->state))
+		return dev_err_probe(dev, PTR_ERR(ss->state),
+				     "failed to acquire sleepstate entry\n");
+
+	ret = qcom_smem_state_update_bits(ss->state, AWAKE_BIT, AWAKE_BIT);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set the awake bit\n");
+
+	irq = of_irq_get_byname(dev->of_node, "smp2p-sleepstate-in");
+	if (irq < 0)
+		return dev_err_probe(dev, irq, "failed to get the sleepstate IRQ\n");
+
+	/* The source must exist before the IRQ can invoke its handler. */
+	ss->ws = wakeup_source_register(dev, "smp2p-sleepstate");
+	if (!ss->ws)
+		return -ENOMEM;
+
+	ret = devm_add_action_or_reset(dev, smp2p_sleepstate_release_ws, ss);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, irq, NULL, smp2p_sleepstate_handler,
+					IRQF_ONESHOT | IRQF_NO_SUSPEND |
+					IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
+					"smp2p_sleepstate", ss);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request the sleepstate IRQ\n");
+
+	ss->pm_nb.notifier_call = smp2p_sleepstate_pm_notifier;
+	ss->pm_nb.priority = INT_MAX;
+	ret = register_pm_notifier(&ss->pm_nb);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register the PM notifier\n");
+
+	/* Reverse devres order: notifier, synchronized IRQ, wakeup source. */
+	return devm_add_action_or_reset(dev, smp2p_sleepstate_release_notifier, ss);
+}
+
+static const struct of_device_id smp2p_sleepstate_of_match[] = {
+	{ .compatible = "qcom,smp2p-sleepstate" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, smp2p_sleepstate_of_match);
+
+static struct platform_driver smp2p_sleepstate_driver = {
+	.probe = smp2p_sleepstate_probe,
+	.driver = {
+		.name = "smp2p_sleepstate",
+		.of_match_table = smp2p_sleepstate_of_match,
+	},
+};
+module_platform_driver(smp2p_sleepstate_driver);
+
+MODULE_DESCRIPTION("Qualcomm SMP2P sleep-state notifier");
+MODULE_LICENSE("GPL");
