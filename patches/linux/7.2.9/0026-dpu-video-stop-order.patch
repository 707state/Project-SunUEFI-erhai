From 8f353c130fee0fcf09afbe10e7fc58f901931418 Mon Sep 17 00:00:00 2001
From: Junhao Xie <bigfoot@radxa.com>
Date: Sun, 6 Sep 2026 18:59:24 +0800
Subject: [PATCH] drm/msm/dpu: stop the video pipeline before the timing engine

dpu_encoder_phys_vid_disable() stops the timing engine, waits for the last frame to go out, and only then calls dpu_encoder_helper_phys_cleanup(). That helper unbinds the INTF, MERGE_3D, CDM and DSC blocks, resets the mixers, and finishes with a CTL flush followed by a CTL_START.

In video mode a flush is consumed at a frame boundary. By the time the cleanup runs there are no more frame boundaries, so the flush is left to the CTL_START that follows it -- a trigger video mode does not otherwise use.

Signed-off-by: Junhao Xie <bigfoot@radxa.com>
---
 .../gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c   | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
index 35d25d8c30bf52..e1174b76c52f78 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -617,6 +617,19 @@ static void dpu_encoder_phys_vid_disable(struct dpu_encoder_phys *phys_enc)
 		return;
 	}
 
+	/*
+	 * Tear the pipeline down while the timing engine is still running.
+	 * The cleanup ends in a CTL flush, and in video mode a flush is only
+	 * consumed at a frame boundary.  Doing this after the timing engine
+	 * has been stopped leaves the flush to be swallowed by the CTL_START
+	 * that follows it, which video mode does not otherwise use, and the
+	 * teardown then only reaches the shadow registers.  The stale active
+	 * configuration survives into the next enable and the SSPP fetch
+	 * never restarts: every register reads back correctly while the
+	 * layer mixer keeps emitting its border colour.
+	 */
+	dpu_encoder_helper_phys_cleanup(phys_enc);
+
 	spin_lock_irqsave(phys_enc->enc_spinlock, lock_flags);
 	phys_enc->hw_intf->ops.enable_timing(phys_enc->hw_intf, 0);
 	if (dpu_encoder_phys_vid_is_master(phys_enc))
@@ -661,7 +674,6 @@ static void dpu_encoder_phys_vid_disable(struct dpu_encoder_phys *phys_enc)
 		}
 	}
 
-	dpu_encoder_helper_phys_cleanup(phys_enc);
 	phys_enc->enable_state = DPU_ENC_DISABLED;
 }
 
