Subject: [PATCH] drm/panel: preserve Piano vendor frame-rate command order

Factory CSOT P81_35 XML writes B2 before B3; BOE P81_42 writes B3 before B2.
BigfootACA/linux 77ca90b0818 uses the same per-vendor distinction.
Retain the existing mode values and supply/reset sequence.

Tested on CSOT: 120 Hz boot displays normally, but switching to 60 Hz
still produces a grey physical screen. This is an OEM alignment candidate,
not a verified modeset fix; it is not in the release patch list.

--- a/drivers/gpu/drm/panel/panel-novatek-nt36532.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36532.c
@@ -54,6 +54,7 @@
 
 	bool is_dual_dsi;
 	bool piano_reset_sequence;
+	bool fps_b2_first;
 };
 
 static const struct regulator_bulk_data nt36532_supplies[] = {
@@ -502,6 +503,8 @@
 	struct mipi_dsi_multi_context multi_ctx = { .dsi = to_primary_dsi(ctx) };
 	struct mipi_dsi_multi_context *dsi_ctx = &multi_ctx;
 	struct drm_dsc_picture_parameter_set pps;
+	u8 fps_b2[] = {0xb2, 0x91};
+	u8 fps_b3[] = {0xb3, 0x40};
 
 	/* ESD init */
 	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xff, 0x27);
@@ -612,19 +615,24 @@
 	/* Panel side refresh rate control */
 	switch (drm_mode_vrefresh(mode)) {
 	case 144:
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x00);
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x00);
+		fps_b3[1] = 0x00;
+		fps_b2[1] = 0x00;
 		break;
 	case 90:
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x80);
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x00);
+		fps_b3[1] = 0x80;
+		fps_b2[1] = 0x00;
 		break;
 	default:
 		/* 120 Hz panel timing, also used for 60 Hz */
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x40);
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x91);
 		break;
 	}
+	if (ctx->panel_info->fps_b2_first) {
+		mipi_dsi_dcs_write_buffer_multi(dsi_ctx, fps_b2, sizeof(fps_b2));
+		mipi_dsi_dcs_write_buffer_multi(dsi_ctx, fps_b3, sizeof(fps_b3));
+	} else {
+		mipi_dsi_dcs_write_buffer_multi(dsi_ctx, fps_b3, sizeof(fps_b3));
+		mipi_dsi_dcs_write_buffer_multi(dsi_ctx, fps_b2, sizeof(fps_b2));
+	}
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
 	mipi_dsi_msleep(dsi_ctx, 120);
@@ -763,7 +771,7 @@
 	.is_dual_dsi = true,
 };
 
-#define PIANO_PANEL_INFO(_init) {						\
+#define PIANO_PANEL_INFO(_init, _b2_first) {				\
 	.lanes = 4,								\
 	.format = MIPI_DSI_FMT_RGB101010,					\
 	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_CLOCK_NON_CONTINUOUS |	\
@@ -775,14 +783,15 @@
 	.dsc_cfg = &piano_dsc_cfg,						\
 	.init_sequence = _init,							\
 	.piano_reset_sequence = true,						\
+	.fps_b2_first = _b2_first,						\
 	.is_dual_dsi = true,							\
 }
 
 static const struct panel_info piano_boe_panel_info =
-	PIANO_PANEL_INFO(piano_boe_init_sequence);
+	PIANO_PANEL_INFO(piano_boe_init_sequence, false);
 
 static const struct panel_info piano_csot_panel_info =
-	PIANO_PANEL_INFO(piano_csot_init_sequence);
+	PIANO_PANEL_INFO(piano_csot_init_sequence, true);
 
 static const struct of_device_id nt36532_of_match[] = {
 	{ .compatible = "csot,ppc100hb1-1", .data = &csot_panel_info },
