From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] HID: nanosic: default the Piano cover backlight on

The cover backlight only came up after the desktop raised the LED from
zero, so a fresh boot showed a dark keyboard until the user changed it.

Set the integration default on the registered LED for the Piano variant
so the light is on at the usual level from bring-up, while the LED class
still saves and restores whatever the user selects.

Signed-off-by: slwyts <slwyts@foxmail.com>
---
diff --git a/drivers/hid/hid-nanosic-wn8030.c b/drivers/hid/hid-nanosic-wn8030.c
index 1f5f1bcc728..096c07a8e10 100644
--- a/drivers/hid/hid-nanosic-wn8030.c
+++ b/drivers/hid/hid-nanosic-wn8030.c
@@ -47,6 +47,7 @@
  * @boot_ms: wait for the bootrom after reset release
  * @wake_ms: wait after the sleep pin is released
  * @bl_write_ms: wait after every bootloader write
+ * @kbd_backlight_default: initial keyboard backlight level, 0 stays off
  */
 struct nanosic_wn8030_variant {
 	const u8 *kbd_rdesc;
@@ -62,6 +63,7 @@ struct nanosic_wn8030_variant {
 	unsigned int boot_ms;
 	unsigned int wake_ms;
 	unsigned int bl_write_ms;
+	u8 kbd_backlight_default;
 };
 
 static const char * const nanosic_wn8030_supply_names[] = {
@@ -1946,6 +1948,9 @@ static int nanosic_wn8030_probe(struct i2c_client *client)
 
 	nanosic->kbd_backlight_led.name = "nanosic::kbd_backlight";
 	nanosic->kbd_backlight_led.max_brightness = 100;
+	/* Bring the cover backlight up at the integration default instead of
+	 * requiring the desktop to raise it from zero on every boot. */
+	nanosic->kbd_backlight_led.brightness = nanosic->variant->kbd_backlight_default;
 	nanosic->kbd_backlight_led.brightness_set_blocking =
 		nanosic_wn8030_kbd_backlight_set;
 	ret = devm_led_classdev_register(nanosic->dev, &nanosic->kbd_backlight_led);
@@ -2081,6 +2086,7 @@ static const struct nanosic_wn8030_variant nanosic_wn8030_piano = {
 	.boot_ms = 500,
 	.wake_ms = 50,
 	.bl_write_ms = 3,
+	.kbd_backlight_default = 35,
 };
 
 static const struct of_device_id __maybe_unused nanosic_wn8030_of_match[] = {
